# Dépendances et sorties de build
node_modules/
dist/
target/
src-tauri/gen/

# Contrôleur compilé : régénéré par `bun run core` (copié dans src-tauri/binaries/)
app/src-tauri/binaries/fancontroller-core-*.exe
controller/*.exe

# Données créées à l'exécution à côté du contrôleur
controller/profiles.json
controller/settings.json
# IMPORTANT : clé secrète de l'API, créée par le contrôleur ; ne doit jamais être versionnée, où qu'il tourne
api.key
*.db
*.tmp

# Journaux et éditeurs
*.log
.idea/
.vscode/
.DS_Store


# Données de session créées à côté du contrôleur : historique, règles d automatisation, icônes en cache
history.jsonl
automation.json
controller/icons/
