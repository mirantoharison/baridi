{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baridi - Fancontroller",
  "version": "2.0.0",
  "identifier": "com.fancontroller.v2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run core && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Baridi - Fancontroller",
        "width": 800,
        "height": 800,
        "minWidth": 800,
        "minHeight": 800,
        "resizable": false,
        "maximizable": false,
        "visible": false
      },
      {
        "label": "widget",
        "title": "Baridi - Widget",
        "url": "index.html?widget=1",
        "width": 400,
        "height": 212,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/fancontroller-core"
    ],
    "resources": {
      "binaries/AsusWinIO64.dll": "AsusWinIO64.dll",
      "binaries/PsExec.exe": "PsExec.exe",
      "../../README.md": "README.md"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
