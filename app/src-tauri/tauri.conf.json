{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baridi - Fancontroller",
  "version": "2.0.0",
  "identifier": "com.fancontroller.v2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run core && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Baridi - Fancontroller",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/fancontroller-core"],
    "resources": {
      "binaries/AsusWinIO64.dll": "AsusWinIO64.dll",
      "binaries/PsExec.exe": "PsExec.exe"
    }
  }
}
